<UserControl x:Class="CheckersClient.UserControls.PlayerCardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:model="clr-namespace:Model;assembly=Model"
             d:DataContext="{d:DesignInstance Type=model:User, IsDesignTimeCreatable=False}"
             mc:Ignorable="d">
    <!-- Outer button-styled border so the whole card is clickable.
         The host wires the Clicked event to navigate to the profile
         page for the bound User. -->
    <Border x:Name="Root"
            Cursor="Hand"
            MouseLeftButtonUp="OnRootClicked">
        <Border.Style>
            <Style TargetType="Border" BasedOn="{StaticResource Card}">
                <Setter Property="Padding" Value="14" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource PanelBackgroundBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Avatar: shows the profile picture when set, otherwise
                 falls back to the coloured initials disc. -->
            <Grid Width="44" Height="44" Grid.Column="0">
                <Grid Visibility="{Binding ProfilePicture,
                                   Converter={StaticResource NullToVis},
                                   ConverterParameter=Invert}">
                    <Ellipse Fill="{Binding Username, Converter={StaticResource AvatarColor}}" />
                    <TextBlock Text="{Binding Username, Converter={StaticResource Initials}}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="16" FontWeight="Bold" Foreground="White" />
                </Grid>
                <Ellipse Visibility="{Binding ProfilePicture,
                                      Converter={StaticResource NullToVis}}">
                    <Ellipse.Fill>
                        <ImageBrush Stretch="UniformToFill"
                                    ImageSource="{Binding ProfilePicture,
                                                  Converter={StaticResource BytesToImage}}" />
                    </Ellipse.Fill>
                </Ellipse>
            </Grid>

            <!-- Name + role + W/L/D -->
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Username}"
                               Style="{StaticResource BodyText}"
                               FontWeight="SemiBold" />
                    <Border Background="{StaticResource AccentBrush}"
                            CornerRadius="3"
                            Padding="6,1"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Role}" Value="Admin">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="ADMIN"
                                   Foreground="{StaticResource AccentTextBrush}"
                                   FontSize="10" FontWeight="Bold" />
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource MutedText}"
                               Text="{Binding Wins, StringFormat='{}{0}W'}" />
                    <TextBlock Style="{StaticResource MutedText}" Text=" · " />
                    <TextBlock Style="{StaticResource MutedText}"
                               Text="{Binding Losses, StringFormat='{}{0}L'}" />
                    <TextBlock Style="{StaticResource MutedText}" Text=" · " />
                    <TextBlock Style="{StaticResource MutedText}"
                               Text="{Binding Draws, StringFormat='{}{0}D'}" />
                </StackPanel>
            </StackPanel>

            <!-- Rating -->
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock Text="{Binding Rating}"
                           Foreground="{StaticResource AccentBrush}"
                           FontSize="20" FontWeight="Bold"
                           HorizontalAlignment="Right" />
                <TextBlock Text="rating" Style="{StaticResource MutedText}"
                           HorizontalAlignment="Right" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
