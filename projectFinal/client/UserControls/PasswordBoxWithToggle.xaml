<UserControl x:Class="CheckersClient.UserControls.PasswordBoxWithToggle"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <!-- Reusable secret-input control:
           * Hides the secret behind a real PasswordBox by default
             (so the value never lives in a bindable string property)
           * Toggle button on the right shows/hides the secret using
             a TextBox overlay; the two are kept in sync through the
             code-behind so reading .Password always yields the
             current value regardless of which surface is visible.

         The visual chrome matches StyledTextBox / StyledPasswordBox
         so this drops cleanly into the existing forms. -->
    <Border x:Name="OuterBorder"
            Background="{StaticResource WindowBackgroundBrush}"
            BorderBrush="{StaticResource DividerBrush}"
            BorderThickness="1"
            CornerRadius="6">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Hidden surface (default) -->
            <PasswordBox x:Name="PART_Password"
                         Grid.Column="0"
                         Background="Transparent"
                         Foreground="{StaticResource PrimaryTextBrush}"
                         BorderThickness="0"
                         Padding="10,8"
                         FontSize="14"
                         CaretBrush="{StaticResource AccentBrush}"
                         PasswordChanged="OnPasswordChanged"
                         GotKeyboardFocus="OnAnyFocus"
                         LostKeyboardFocus="OnAnyBlur" />

            <!-- Visible surface (shown when toggled on) -->
            <TextBox x:Name="PART_Plain"
                     Grid.Column="0"
                     Background="Transparent"
                     Foreground="{StaticResource PrimaryTextBrush}"
                     BorderThickness="0"
                     Padding="10,8"
                     FontSize="14"
                     CaretBrush="{StaticResource AccentBrush}"
                     Visibility="Collapsed"
                     TextChanged="OnPlainChanged"
                     GotKeyboardFocus="OnAnyFocus"
                     LostKeyboardFocus="OnAnyBlur" />

            <!-- Eye toggle. Both icon paths live in the Button's
                 Content (not its template) so x:Name generates real
                 fields and the code-behind can flip them on click. -->
            <Button x:Name="PART_Toggle"
                    Grid.Column="1"
                    Width="38"
                    Background="Transparent"
                    BorderThickness="0"
                    Focusable="False"
                    Cursor="Hand"
                    ToolTip="Show password"
                    Click="OnToggle">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="Transparent"
                                CornerRadius="4"
                                Margin="0,2,2,2">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#22F4D060" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <Grid>
                    <!-- Eye-open (Material 'eye') -->
                    <Path x:Name="PART_IconOpen"
                          Width="18" Height="18"
                          Stretch="Uniform"
                          Data="M12,4.5C7,4.5 2.73,7.61 1,12C2.73,16.39 7,19.5 12,19.5C17,19.5 21.27,16.39 23,12C21.27,7.61 17,4.5 12,4.5M12,17A5,5 0 0,1 7,12A5,5 0 0,1 12,7A5,5 0 0,1 17,12A5,5 0 0,1 12,17M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9Z">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Fill" Value="{StaticResource SecondaryTextBrush}" />
                                <Style.Triggers>
                                    <DataTrigger
                                        Binding="{Binding IsMouseOver,
                                                  RelativeSource={RelativeSource AncestorType=Button}}"
                                        Value="True">
                                        <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                    <!-- Eye-off (Material 'eye-off') -->
                    <Path x:Name="PART_IconClosed"
                          Width="18" Height="18"
                          Stretch="Uniform"
                          Visibility="Collapsed"
                          Data="M11.83,9L15,12.16C15,12.11 15,12.05 15,12A3,3 0 0,0 12,9C11.94,9 11.89,9 11.83,9M7.53,9.8L9.08,11.35C9.03,11.56 9,11.77 9,12A3,3 0 0,0 12,15C12.22,15 12.44,14.97 12.65,14.92L14.2,16.47C13.53,16.8 12.79,17 12,17A5,5 0 0,1 7,12C7,11.21 7.2,10.47 7.53,9.8M2,4.27L4.28,6.55L4.73,7C3.08,8.3 1.78,10 1,12C2.73,16.39 7,19.5 12,19.5C13.55,19.5 15.03,19.2 16.38,18.66L16.81,19.08L19.73,22L21,20.73L3.27,3M12,7A5,5 0 0,1 17,12C17,12.64 16.87,13.26 16.64,13.82L19.57,16.75C21.07,15.5 22.27,13.86 23,12C21.27,7.61 17,4.5 12,4.5C10.6,4.5 9.26,4.75 8,5.2L10.17,7.35C10.74,7.13 11.35,7 12,7Z">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Fill" Value="{StaticResource SecondaryTextBrush}" />
                                <Style.Triggers>
                                    <DataTrigger
                                        Binding="{Binding IsMouseOver,
                                                  RelativeSource={RelativeSource AncestorType=Button}}"
                                        Value="True">
                                        <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                </Grid>
            </Button>
        </Grid>
    </Border>
</UserControl>
