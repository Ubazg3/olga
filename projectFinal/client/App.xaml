<Application x:Class="CheckersClient.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:CheckersClient.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Colors.xaml" />
                <ResourceDictionary Source="Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Value converters wired up once at app level so every
                 view can use them by StaticResource. -->
            <conv:BooleanToVisibilityConverter        x:Key="BoolToVis" />
            <conv:InverseBooleanConverter             x:Key="InverseBool" />
            <conv:NullToVisibilityConverter           x:Key="NullToVis" />
            <conv:PieceCodeToBrushConverter           x:Key="PieceToBrush" />
            <conv:PieceCodeToVisibilityConverter      x:Key="PieceToVis" />
            <conv:PieceCodeToKingConverter            x:Key="PieceToKing" />
            <conv:StatusToTextConverter               x:Key="StatusToText" />
            <conv:GameResultConverter                 x:Key="GameResult" />
            <conv:AvatarColorConverter                x:Key="AvatarColor" />
            <conv:InitialsConverter                   x:Key="Initials" />
            <conv:ByteArrayToImageConverter           x:Key="BytesToImage" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
