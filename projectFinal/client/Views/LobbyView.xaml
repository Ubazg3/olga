<UserControl x:Class="CheckersClient.Views.LobbyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CheckersClient.ViewModels"
             xmlns:uc="clr-namespace:CheckersClient.UserControls"
             d:DataContext="{d:DesignInstance Type=vm:LobbyViewModel, IsDesignTimeCreatable=False}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid Background="{StaticResource WindowBackgroundBrush}">
        <Grid Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ====== Top bar: branding + admin entry + logout ====== -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <TextBlock Text="Checkers" Style="{StaticResource H1Text}" />
                    <TextBlock Text="lobby"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="28" FontWeight="Light"
                               Margin="8,0,0,0" VerticalAlignment="Bottom" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <!-- About / project info -->
                    <Button Style="{StaticResource SecondaryButton}"
                            Click="OnAboutClick"
                            Padding="14,10"
                            Margin="0,0,8,0"
                            ToolTip="About this project">
                        <TextBlock Text="ⓘ" FontSize="16" FontWeight="Bold" />
                    </Button>
                    <!-- Admin functionality lives in the web console
                         now; the desktop client is purely for playing.
                         Kept the OpenAdminCommand wired in case you
                         want to expose this again. -->
                    <!--
                    <Button Style="{StaticResource SecondaryButton}"
                            Content="Admin panel"
                            Command="{Binding OpenAdminCommand}"
                            Visibility="{Binding IsAdmin,
                                         Converter={StaticResource BoolToVis}}"
                            Margin="0,0,8,0" />
                    -->
                    <!-- The lobby auto-polls every 5 s, so an explicit
                         Refresh button isn't needed. -->
                    <Button Style="{StaticResource SecondaryButton}"
                            Content="Sign out"
                            Command="{Binding LogoutCommand}" />
                </StackPanel>
            </Grid>

            <!-- ====== Main lobby area ====== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="*"   />
                    <ColumnDefinition Width="320" />
                </Grid.ColumnDefinitions>

                <!-- ===== Left column: my profile + recent games ===== -->
                <ScrollViewer Grid.Column="0" Margin="0,0,12,0"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H3Text}" Text="MY PROFILE" Margin="4,0,0,8" />
                        <uc:PlayerCardControl DataContext="{Binding CurrentUser}"
                                              Clicked="OnPlayerCardClicked" />

                        <TextBlock Style="{StaticResource H3Text}" Text="RECENT GAMES" Margin="4,16,0,8" />
                        <Border Style="{StaticResource Card}" Padding="8">
                            <ItemsControl ItemsSource="{Binding RecentGames}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding StartedAt, StringFormat='{}{0:dd MMM HH:mm}'}"
                                                           Style="{StaticResource MutedText}" />
                                                <TextBlock>
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}#{0}  ({1} moves)">
                                                            <Binding Path="Id" />
                                                            <Binding Path="MoveCount" />
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding Status, Converter={StaticResource StatusToText}}"
                                                       Style="{StaticResource MutedText}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== Center: leaderboard + Find a game =====
                     Grid layout pins the title and the "Ready to play"
                     card to fixed positions, and lets the leaderboard
                     scroll inside a star-sized middle row — so the
                     buttons are never pushed off screen no matter how
                     long the player list grows. -->
                <Border Grid.Column="1" Style="{StaticResource Panel}"
                        Margin="6,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Style="{StaticResource H2Text}" Text="Top players" />
                        <TextBlock Grid.Row="1"
                                   Style="{StaticResource MutedText}"
                                   Text="Sorted by Elo rating — earn points by winning games."
                                   Margin="0,2,0,12" />

                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding TopPlayers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <uc:PlayerCardControl Clicked="OnPlayerCardClicked" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Border Grid.Row="3"
                                Style="{StaticResource Card}"
                                Background="{StaticResource WindowBackgroundBrush}"
                                Padding="20"
                                Margin="0,12,0,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Style="{StaticResource H2Text}"
                                           Text="Ready to play?"
                                           HorizontalAlignment="Center" />
                                <TextBlock Style="{StaticResource MutedText}"
                                           Text="{Binding StatusMessage}"
                                           HorizontalAlignment="Center"
                                           Margin="0,4,0,12" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Style="{StaticResource PrimaryButton}"
                                            Content="{Binding FindGameLabel}"
                                            Command="{Binding FindGameCommand}"
                                            Padding="28,12"
                                            Margin="0,0,8,0" />
                                    <Button Style="{StaticResource SecondaryButton}"
                                            Content="🤖  Play vs bot"
                                            Command="{Binding PlayBotCommand}"
                                            Padding="20,12" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- ===== Right column: online players ===== -->
                <ScrollViewer Grid.Column="2" Margin="12,0,0,0"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H3Text}" Text="ONLINE NOW" Margin="4,0,0,8" />
                        <ItemsControl ItemsSource="{Binding OnlinePlayers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <uc:PlayerCardControl Clicked="OnPlayerCardClicked" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
