<UserControl x:Class="CheckersClient.Views.AdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CheckersClient.ViewModels"
             xmlns:uc="clr-namespace:CheckersClient.UserControls"
             d:DataContext="{d:DesignInstance Type=vm:AdminViewModel, IsDesignTimeCreatable=False}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid Background="{StaticResource WindowBackgroundBrush}">
        <Grid Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource H1Text}" Text="Admin panel" />
                    <TextBlock Style="{StaticResource MutedText}"
                               Text="{Binding StatusMessage}"
                               Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <!-- Auto-polled every 5 s; no button needed. -->
                    <Button Style="{StaticResource SecondaryButton}"
                            Content="Back to lobby"
                            Command="{Binding BackCommand}" />
                </StackPanel>
            </Grid>

            <!-- Two columns: users + recent games -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ===== Users ===== -->
                <Border Grid.Column="0" Style="{StaticResource Panel}" Margin="0,0,12,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Style="{StaticResource H2Text}" Text="Users" />
                        <Border DockPanel.Dock="Top" Height="1"
                                Background="{StaticResource DividerBrush}" Margin="0,8" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Users}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Card}" Padding="12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                    <Grid Width="36" Height="36">
                                                        <Grid Visibility="{Binding ProfilePicture,
                                                                          Converter={StaticResource NullToVis},
                                                                          ConverterParameter=Invert}">
                                                            <Ellipse Fill="{Binding Username, Converter={StaticResource AvatarColor}}" />
                                                            <TextBlock Text="{Binding Username, Converter={StaticResource Initials}}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       Foreground="White" FontWeight="Bold" />
                                                        </Grid>
                                                        <Ellipse Visibility="{Binding ProfilePicture,
                                                                              Converter={StaticResource NullToVis}}">
                                                            <Ellipse.Fill>
                                                                <ImageBrush Stretch="UniformToFill"
                                                                            ImageSource="{Binding ProfilePicture,
                                                                                          Converter={StaticResource BytesToImage}}" />
                                                            </Ellipse.Fill>
                                                        </Ellipse>
                                                    </Grid>
                                                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Style="{StaticResource BodyText}"
                                                                   FontWeight="SemiBold"
                                                                   Text="{Binding Username}" />
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Style="{StaticResource MutedText}"
                                                                       Text="{Binding Role}" />
                                                            <TextBlock Style="{StaticResource MutedText}" Text="  ·  " />
                                                            <TextBlock Style="{StaticResource MutedText}"
                                                                       Text="{Binding Rating, StringFormat='{}rating {0}'}" />
                                                            <TextBlock Style="{StaticResource MutedText}" Text="  ·  " />
                                                            <TextBlock Style="{StaticResource MutedText}"
                                                                       Text="{Binding Email}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </StackPanel>
                                                <Border Grid.Column="1"
                                                        Background="{StaticResource DangerBrush}"
                                                        CornerRadius="3"
                                                        Padding="8,2"
                                                        VerticalAlignment="Center"
                                                        Margin="0,0,8,0"
                                                        Visibility="{Binding IsBanned,
                                                                     Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="BANNED" Foreground="White"
                                                               FontWeight="Bold" FontSize="11" />
                                                </Border>
                                                <Button Grid.Column="2"
                                                        Style="{StaticResource SecondaryButton}"
                                                        Padding="10,6"
                                                        Command="{Binding DataContext.ToggleBanCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}">
                                                    <TextBlock>
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="Ban" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsBanned}" Value="True">
                                                                        <Setter Property="Text" Value="Unban" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- ===== Recent games ===== -->
                <Border Grid.Column="1" Style="{StaticResource Panel}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Style="{StaticResource H2Text}" Text="Recent games" />
                        <Border DockPanel.Dock="Top" Height="1"
                                Background="{StaticResource DividerBrush}" Margin="0,8" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding RecentGames}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Card}" Padding="10">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource MutedText}"
                                                           Text="{Binding StartedAt, StringFormat='{}{0:dd MMM HH:mm}'}" />
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource BodyText}"
                                                               Text="{Binding WhitePlayerId, StringFormat='{}#{0}'}" />
                                                    <TextBlock Style="{StaticResource BodyText}" Text="  vs  " />
                                                    <TextBlock Style="{StaticResource BodyText}"
                                                               Text="{Binding BlackPlayerId, StringFormat='{}#{0}'}" />
                                                </StackPanel>
                                                <TextBlock Style="{StaticResource MutedText}"
                                                           Text="{Binding Status, Converter={StaticResource StatusToText}}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
