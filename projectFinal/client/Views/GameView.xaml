<UserControl x:Class="CheckersClient.Views.GameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CheckersClient.ViewModels"
             xmlns:uc="clr-namespace:CheckersClient.UserControls"
             d:DataContext="{d:DesignInstance Type=vm:GameViewModel, IsDesignTimeCreatable=False}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid Background="{StaticResource WindowBackgroundBrush}">
        <Grid Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <!-- ===== Centre column: the board ===== -->
            <DockPanel Grid.Column="0">
                <!-- Top player (the one whose pieces are at the top) -->
                <Border DockPanel.Dock="Top"
                        Style="{StaticResource Card}" Padding="14"
                        Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Grid.Column="0">
                            <Grid Width="36" Height="36">
                                <Ellipse Fill="{Binding State.BlackUsername, Converter={StaticResource AvatarColor}}" />
                                <TextBlock Text="{Binding State.BlackUsername, Converter={StaticResource Initials}}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="White" FontWeight="Bold" />
                            </Grid>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding State.BlackUsername}"
                                           Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource MutedText}"
                                           Text="{Binding State.BlackPiecesLeft, StringFormat='{}{0} pieces left'}" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                   Text="BLACK" FontWeight="Bold"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                    </Grid>
                </Border>

                <!-- Bottom player (you) -->
                <Border DockPanel.Dock="Bottom"
                        Style="{StaticResource Card}" Padding="14"
                        Margin="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Grid.Column="0">
                            <Grid Width="36" Height="36">
                                <Ellipse Fill="{Binding State.WhiteUsername, Converter={StaticResource AvatarColor}}" />
                                <TextBlock Text="{Binding State.WhiteUsername, Converter={StaticResource Initials}}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="White" FontWeight="Bold" />
                            </Grid>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding State.WhiteUsername}"
                                           Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource MutedText}"
                                           Text="{Binding State.WhitePiecesLeft, StringFormat='{}{0} pieces left'}" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                   Text="WHITE" FontWeight="Bold"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                    </Grid>
                </Border>

                <!-- The board itself, centered and square. -->
                <Viewbox Stretch="Uniform">
                    <uc:CheckersBoardControl x:Name="Board"
                                             DataContext="{Binding Board}"
                                             SquareClicked="OnBoardSquareClicked"
                                             Width="640" Height="640" />
                </Viewbox>
            </DockPanel>

            <!-- ===== Right column: status + move list + resign ===== -->
            <Border Grid.Column="1" Style="{StaticResource Panel}"
                    Margin="20,0,0,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Style="{StaticResource H2Text}" Text="{Binding TurnLabel}" />
                        <TextBlock Style="{StaticResource MutedText}"
                                   Text="{Binding State.LastMoveNotation, StringFormat='Last: {0}'}"
                                   Margin="0,2,0,0" />
                        <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,12" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <!-- Draw-offer banner: only shown when the
                             opponent has an offer pending. -->
                        <Border Background="#22F4D060"
                                BorderBrush="{StaticResource AccentBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12"
                                Margin="0,0,0,8"
                                Visibility="{Binding OpponentOfferedDraw,
                                             Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="Opponent offers a draw"
                                           Style="{StaticResource BodyText}"
                                           FontWeight="SemiBold" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Style="{StaticResource PrimaryButton}"
                                            Content="Accept"
                                            Padding="10,6"
                                            Command="{Binding AcceptDrawCommand}"
                                            Margin="0,0,8,0" />
                                    <Button Style="{StaticResource SecondaryButton}"
                                            Content="Decline"
                                            Padding="10,6"
                                            Command="{Binding DeclineDrawCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- "Offered draw" muted notice if WE offered. -->
                        <TextBlock Style="{StaticResource MutedText}"
                                   Text="Draw offer sent — waiting for response."
                                   Margin="0,0,0,8"
                                   HorizontalAlignment="Center"
                                   Visibility="{Binding DrawOfferIsMine,
                                                Converter={StaticResource BoolToVis}}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Style="{StaticResource SecondaryButton}"
                                    Content="Offer draw"
                                    Command="{Binding OfferDrawCommand}"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,0,4,0" />
                            <Button Grid.Column="1"
                                    Style="{StaticResource DangerButton}"
                                    Content="Resign"
                                    Command="{Binding ResignCommand}"
                                    HorizontalAlignment="Stretch"
                                    Margin="4,0,0,0" />
                        </Grid>
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding MoveRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Style="{StaticResource MutedText}"
                                                   Text="{Binding Index, StringFormat='{}{0}.'}" />
                                        <TextBlock Grid.Column="1"
                                                   Style="{StaticResource BodyText}"
                                                   Text="{Binding Notation}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
