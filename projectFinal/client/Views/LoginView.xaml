<UserControl x:Class="CheckersClient.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CheckersClient.ViewModels"
             xmlns:val="clr-namespace:CheckersClient.Validation"
             xmlns:uc="clr-namespace:CheckersClient.UserControls"
             d:DataContext="{d:DesignInstance Type=vm:LoginViewModel, IsDesignTimeCreatable=False}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid Background="{StaticResource WindowBackgroundBrush}">
        <Border MaxWidth="420" Style="{StaticResource Panel}"
                VerticalAlignment="Center" HorizontalAlignment="Center"
                Padding="32">
            <StackPanel>
                <!-- Branding -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,24">
                    <TextBlock Text="Checkers"
                               Style="{StaticResource H1Text}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Online multi-player board game"
                               Style="{StaticResource MutedText}"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0" />
                </StackPanel>

                <TabControl Background="Transparent" BorderThickness="0">
                    <TabControl.Resources>
                        <Style TargetType="TabItem">
                            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Padding"    Value="14,8" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TabItem">
                                        <Border x:Name="bd"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{StaticResource AccentBrush}"
                                                BorderThickness="0,0,0,2"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter ContentSource="Header"
                                                              HorizontalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="bd"
                                                        Property="Background"
                                                        Value="#22F4D060" />
                                                <Setter Property="Foreground"
                                                        Value="{StaticResource AccentBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TabControl.Resources>

                    <!-- ===== Login tab ===== -->
                    <TabItem Header="Sign in">
                        <StackPanel Margin="0,16,0,0">
                            <TextBlock Text="USERNAME" Style="{StaticResource H3Text}"
                                       Margin="0,0,0,4" />
                            <TextBox Style="{StaticResource StyledTextBox}"
                                     x:Name="LoginUsernameBox"
                                     Margin="0,0,0,12">
                                <TextBox.Text>
                                    <Binding Path="LoginUsername"
                                             UpdateSourceTrigger="PropertyChanged">
                                        <!-- Login is lenient by design;
                                             see LoginNotEmptyRule for the why. -->
                                        <Binding.ValidationRules>
                                            <val:LoginNotEmptyRule
                                                FieldName="Username"
                                                ValidatesOnTargetUpdated="False" />
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                            </TextBox>

                            <TextBlock Text="PASSWORD" Style="{StaticResource H3Text}"
                                       Margin="0,0,0,4" />
                            <uc:PasswordBoxWithToggle x:Name="LoginPasswordBox"
                                                      Margin="0,0,0,16" />

                            <Button Style="{StaticResource PrimaryButton}"
                                    Content="Sign in"
                                    Command="{Binding LoginCommand}"
                                    Click="OnLoginClick"
                                    IsDefault="True"
                                    HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </TabItem>

                    <!-- ===== Sign-up tab ===== -->
                    <TabItem Header="Sign up">
                        <StackPanel Margin="0,16,0,0">
                            <TextBlock Text="USERNAME" Style="{StaticResource H3Text}"
                                       Margin="0,0,0,4" />
                            <TextBox Style="{StaticResource StyledTextBox}"
                                     Margin="0,0,0,12">
                                <TextBox.Text>
                                    <Binding Path="RegUsername"
                                             UpdateSourceTrigger="PropertyChanged">
                                        <Binding.ValidationRules>
                                            <val:UsernameRule ValidatesOnTargetUpdated="False" />
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                            </TextBox>

                            <TextBlock Text="EMAIL  (optional)" Style="{StaticResource H3Text}"
                                       Margin="0,0,0,4" />
                            <TextBox Style="{StaticResource StyledTextBox}"
                                     Margin="0,0,0,12">
                                <TextBox.Text>
                                    <Binding Path="RegEmail"
                                             UpdateSourceTrigger="PropertyChanged">
                                        <Binding.ValidationRules>
                                            <val:EmailRule ValidatesOnTargetUpdated="False" />
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                            </TextBox>

                            <TextBlock Text="BIRTH DATE  (optional)" Style="{StaticResource H3Text}"
                                       Margin="0,0,0,4" />
                            <DatePicker Style="{StaticResource StyledDatePicker}"
                                        SelectedDate="{Binding RegBirthDate, UpdateSourceTrigger=PropertyChanged}"
                                        Margin="0,0,0,12" />

                            <TextBlock Text="COUNTRY  (optional)" Style="{StaticResource H3Text}"
                                       Margin="0,0,0,4" />
                            <TextBox Style="{StaticResource StyledTextBox}"
                                     Text="{Binding RegCountry, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,12" />

                            <TextBlock Text="PASSWORD" Style="{StaticResource H3Text}"
                                       Margin="0,0,0,4" />
                            <uc:PasswordBoxWithToggle x:Name="RegPasswordBox"
                                                      Margin="0,0,0,16" />

                            <Button Style="{StaticResource PrimaryButton}"
                                    Content="Create account"
                                    Command="{Binding RegisterCommand}"
                                    Click="OnRegisterClick"
                                    HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </TabItem>
                </TabControl>

                <!-- Status / error line -->
                <TextBlock Text="{Binding StatusMessage}"
                           HorizontalAlignment="Center"
                           Margin="0,16,0,0"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
