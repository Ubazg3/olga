<UserControl x:Class="CheckersClient.Views.ReplayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CheckersClient.ViewModels"
             xmlns:uc="clr-namespace:CheckersClient.UserControls"
             d:DataContext="{d:DesignInstance Type=vm:ReplayViewModel, IsDesignTimeCreatable=False}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid Background="{StaticResource WindowBackgroundBrush}">
        <Grid Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <!-- ===== Centre: board ===== -->
            <DockPanel Grid.Column="0">
                <!-- Top player -->
                <Border DockPanel.Dock="Top"
                        Style="{StaticResource Card}" Padding="14"
                        Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Grid.Column="0">
                            <Grid Width="36" Height="36">
                                <Ellipse Fill="{Binding BlackUsername, Converter={StaticResource AvatarColor}}" />
                                <TextBlock Text="{Binding BlackUsername, Converter={StaticResource Initials}}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="White" FontWeight="Bold" />
                            </Grid>
                            <TextBlock Text="{Binding BlackUsername}"
                                       Style="{StaticResource BodyText}" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="10,0,0,0" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                   Text="BLACK" FontWeight="Bold"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                    </Grid>
                </Border>

                <!-- Bottom player -->
                <Border DockPanel.Dock="Bottom"
                        Style="{StaticResource Card}" Padding="14"
                        Margin="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Grid.Column="0">
                            <Grid Width="36" Height="36">
                                <Ellipse Fill="{Binding WhiteUsername, Converter={StaticResource AvatarColor}}" />
                                <TextBlock Text="{Binding WhiteUsername, Converter={StaticResource Initials}}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="White" FontWeight="Bold" />
                            </Grid>
                            <TextBlock Text="{Binding WhiteUsername}"
                                       Style="{StaticResource BodyText}" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="10,0,0,0" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                   Text="WHITE" FontWeight="Bold"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                    </Grid>
                </Border>

                <Viewbox Stretch="Uniform">
                    <uc:CheckersBoardControl DataContext="{Binding Board}"
                                             Width="640" Height="640" />
                </Viewbox>
            </DockPanel>

            <!-- ===== Right: move list + transport controls ===== -->
            <Border Grid.Column="1" Style="{StaticResource Panel}"
                    Margin="20,0,0,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <Button Style="{StaticResource SecondaryButton}"
                                Content="← Back to lobby"
                                Command="{Binding BackCommand}"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,0,12" />
                        <TextBlock Style="{StaticResource H2Text}"
                                   Text="{Binding PositionLabel}" />
                        <TextBlock Style="{StaticResource MutedText}"
                                   Text="{Binding StatusMessage}"
                                   Margin="0,2,0,8" />
                        <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,0,0,8" />

                        <UniformGrid Columns="5" Margin="0,4,0,8">
                            <Button Style="{StaticResource SecondaryButton}"
                                    Content="⏮"
                                    Command="{Binding FirstCommand}"
                                    Padding="6,8"
                                    Margin="2" />
                            <Button Style="{StaticResource SecondaryButton}"
                                    Content="◀"
                                    Command="{Binding PrevCommand}"
                                    Padding="6,8"
                                    Margin="2" />
                            <Button Style="{StaticResource PrimaryButton}"
                                    Content="{Binding PlayLabel}"
                                    Command="{Binding PlayPauseCommand}"
                                    Padding="6,8"
                                    Margin="2"
                                    FontSize="12" />
                            <Button Style="{StaticResource SecondaryButton}"
                                    Content="▶"
                                    Command="{Binding NextCommand}"
                                    Padding="6,8"
                                    Margin="2" />
                            <Button Style="{StaticResource SecondaryButton}"
                                    Content="⏭"
                                    Command="{Binding LastCommand}"
                                    Padding="6,8"
                                    Margin="2" />
                        </UniformGrid>
                        <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,4,0,0" />
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding MoveRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Background="Transparent"
                                            BorderThickness="0"
                                            HorizontalContentAlignment="Stretch"
                                            Padding="6,4"
                                            Cursor="Hand"
                                            Command="{Binding DataContext.JumpCommand,
                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Style="{StaticResource MutedText}"
                                                       Text="{Binding Index, StringFormat='{}{0}.'}" />
                                            <TextBlock Grid.Column="1"
                                                       Style="{StaticResource BodyText}"
                                                       Text="{Binding Notation}" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
