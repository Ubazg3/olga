<UserControl x:Class="CheckersClient.Views.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CheckersClient.ViewModels"
             xmlns:uc="clr-namespace:CheckersClient.UserControls"
             d:DataContext="{d:DesignInstance Type=vm:ProfileViewModel, IsDesignTimeCreatable=False}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid Background="{StaticResource WindowBackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="32" MaxWidth="900" HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*"   />
                </Grid.RowDefinitions>

                <!-- ===== Top bar ===== -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource SecondaryButton}"
                            Content="← Back to lobby"
                            Command="{Binding BackCommand}" />
                </Grid>

                <!-- ===== Hero: avatar, name, role, member since ===== -->
                <Border Grid.Row="1" Style="{StaticResource Panel}" Padding="32">
                    <StackPanel HorizontalAlignment="Center">
                        <!-- Avatar: show image if user has a picture,
                             otherwise the initials fallback. The two
                             are stacked; only one is visible at a time
                             via NullToVisibility on the byte[]. -->
                        <Grid Width="120" Height="120">
                            <!-- Initials fallback (shown when no picture) -->
                            <Grid Visibility="{Binding EditPictureBytes,
                                               Converter={StaticResource NullToVis},
                                               ConverterParameter=Invert}">
                                <Ellipse Fill="{Binding User.Username, Converter={StaticResource AvatarColor}}" />
                                <TextBlock Text="{Binding User.Username, Converter={StaticResource Initials}}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontSize="48" FontWeight="Bold" Foreground="White" />
                            </Grid>
                            <!-- Picture (shown when present); circular
                                 mask via Ellipse + ImageBrush. -->
                            <Ellipse Visibility="{Binding EditPictureBytes,
                                                  Converter={StaticResource NullToVis}}">
                                <Ellipse.Fill>
                                    <ImageBrush Stretch="UniformToFill"
                                                ImageSource="{Binding EditPictureBytes,
                                                              Converter={StaticResource BytesToImage}}" />
                                </Ellipse.Fill>
                            </Ellipse>
                        </Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                            <TextBlock Style="{StaticResource H1Text}"
                                       Text="{Binding User.Username}" />
                            <Border Background="{StaticResource AccentBrush}"
                                    CornerRadius="4" Padding="8,3"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding IsAdmin,
                                                 Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="ADMIN"
                                           Foreground="{StaticResource AccentTextBrush}"
                                           FontSize="11" FontWeight="Bold" />
                            </Border>
                        </StackPanel>
                        <TextBlock Style="{StaticResource MutedText}"
                                   Text="{Binding MemberSinceText}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- ===== Stats strip ===== -->
                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0" Margin="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.Resources>
                            <Style x:Key="StatBlock" TargetType="StackPanel">
                                <Setter Property="Margin" Value="20,16" />
                                <Setter Property="HorizontalAlignment" Value="Center" />
                            </Style>
                            <Style x:Key="StatNumber" TargetType="TextBlock">
                                <Setter Property="FontSize"   Value="32" />
                                <Setter Property="FontWeight" Value="Bold" />
                                <Setter Property="HorizontalAlignment" Value="Center" />
                                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                            </Style>
                            <Style x:Key="StatLabel" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                <Setter Property="HorizontalAlignment" Value="Center" />
                            </Style>
                        </Grid.Resources>

                        <StackPanel Grid.Column="0" Style="{StaticResource StatBlock}">
                            <TextBlock Style="{StaticResource StatNumber}"
                                       Foreground="{StaticResource AccentBrush}"
                                       Text="{Binding User.Rating}" />
                            <TextBlock Style="{StaticResource StatLabel}" Text="Rating" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Style="{StaticResource StatBlock}">
                            <TextBlock Style="{StaticResource StatNumber}"
                                       Foreground="{StaticResource SuccessBrush}"
                                       Text="{Binding User.Wins}" />
                            <TextBlock Style="{StaticResource StatLabel}" Text="Wins" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Style="{StaticResource StatBlock}">
                            <TextBlock Style="{StaticResource StatNumber}"
                                       Foreground="{StaticResource DangerBrush}"
                                       Text="{Binding User.Losses}" />
                            <TextBlock Style="{StaticResource StatLabel}" Text="Losses" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Style="{StaticResource StatBlock}">
                            <TextBlock Style="{StaticResource StatNumber}"
                                       Foreground="{StaticResource InfoBrush}"
                                       Text="{Binding User.Draws}" />
                            <TextBlock Style="{StaticResource StatLabel}" Text="Draws" />
                        </StackPanel>
                        <StackPanel Grid.Column="4" Style="{StaticResource StatBlock}">
                            <TextBlock Style="{StaticResource StatNumber}"
                                       Text="{Binding WinRate}" />
                            <TextBlock Style="{StaticResource StatLabel}" Text="Win rate" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ===== Edit button (own profile, view mode) ===== -->
                <Border Grid.Row="3" Margin="0,12,0,0"
                        Visibility="{Binding IsMine,
                                     Converter={StaticResource BoolToVis}}">
                    <Button Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Right"
                            Content="Edit profile"
                            Command="{Binding BeginEditCommand}"
                            Visibility="{Binding IsEditing,
                                         Converter={StaticResource BoolToVis},
                                         ConverterParameter=Inverse}" />
                </Border>

                <!-- ===== Edit form ===== -->
                <Border Grid.Row="4" Style="{StaticResource Panel}" Margin="0,12,0,0"
                        Visibility="{Binding IsEditing,
                                     Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2Text}" Text="Edit profile" />
                        <TextBlock Style="{StaticResource MutedText}"
                                   Text="Username can't be changed. Leave the password fields empty if you only want to update your email."
                                   Margin="0,4,0,16"
                                   TextWrapping="Wrap" />

                        <TextBlock Text="PROFILE PICTURE" Style="{StaticResource H3Text}" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Button Style="{StaticResource SecondaryButton}"
                                    Content="Choose image…"
                                    Command="{Binding ChoosePictureCommand}"
                                    Margin="0,0,8,0" />
                            <Button Style="{StaticResource SecondaryButton}"
                                    Content="Remove picture"
                                    Command="{Binding RemovePictureCommand}" />
                        </StackPanel>

                        <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,0,0,16" />

                        <TextBlock Text="EMAIL" Style="{StaticResource H3Text}" Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource StyledTextBox}"
                                 Text="{Binding EditEmail, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,16" />

                        <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,0,0,16" />

                        <TextBlock Text="CURRENT PASSWORD" Style="{StaticResource H3Text}" Margin="0,0,0,4" />
                        <uc:PasswordBoxWithToggle x:Name="CurrentPasswordBox"
                                                  Margin="0,0,0,12" />

                        <TextBlock Text="NEW PASSWORD" Style="{StaticResource H3Text}" Margin="0,0,0,4" />
                        <uc:PasswordBoxWithToggle x:Name="NewPasswordBox"
                                                  Margin="0,0,0,12" />

                        <TextBlock Text="CONFIRM NEW PASSWORD" Style="{StaticResource H3Text}" Margin="0,0,0,4" />
                        <uc:PasswordBoxWithToggle x:Name="ConfirmPasswordBox"
                                                  Margin="0,0,0,16" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource SecondaryButton}"
                                    Content="Cancel"
                                    Command="{Binding CancelEditCommand}"
                                    Margin="0,0,8,0" />
                            <Button Style="{StaticResource PrimaryButton}"
                                    Content="Save changes"
                                    Click="OnSaveClick"
                                    Command="{Binding SaveProfileCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ===== Status line ===== -->
                <TextBlock Grid.Row="4"
                           Text="{Binding StatusMessage}"
                           Margin="0,8,0,0"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Bottom"
                           TextWrapping="Wrap"
                           Visibility="{Binding StatusMessage,
                                        Converter={StaticResource NullToVis}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- ===== Recent games ===== -->
                <Border Grid.Row="5" Style="{StaticResource Panel}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2Text}" Text="Recent games" />
                        <TextBlock Text="No games played yet."
                                   Margin="0,8,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RecentGames.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ItemsControl ItemsSource="{Binding RecentGames}" Margin="0,12,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Background="Transparent"
                                            BorderThickness="0"
                                            HorizontalContentAlignment="Stretch"
                                            Padding="0"
                                            Margin="0,0,0,8"
                                            Cursor="Hand"
                                            Command="{Binding DataContext.OpenReplayCommand,
                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                    <Border Style="{StaticResource Card}" Padding="14" Margin="0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Outcome badge -->
                                            <Border Grid.Column="0"
                                                    CornerRadius="4" Padding="8,4"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background"
                                                                Value="{StaticResource MutedTextBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding OutcomeColor}" Value="Success">
                                                                <Setter Property="Background"
                                                                        Value="{StaticResource SuccessBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding OutcomeColor}" Value="Danger">
                                                                <Setter Property="Background"
                                                                        Value="{StaticResource DangerBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding OutcomeColor}" Value="Info">
                                                                <Setter Property="Background"
                                                                        Value="{StaticResource InfoBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Outcome}"
                                                           Foreground="White"
                                                           FontWeight="Bold"
                                                           FontSize="12"
                                                           HorizontalAlignment="Center" />
                                            </Border>

                                            <StackPanel Grid.Column="1" Margin="14,0,0,0"
                                                        VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource BodyText}"
                                                           Text="{Binding Opponent, StringFormat='vs {0}'}" />
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource MutedText}"
                                                               Text="{Binding When, StringFormat='{}{0:dd MMM yyyy HH:mm}'}" />
                                                    <TextBlock Style="{StaticResource MutedText}" Text="  ·  " />
                                                    <TextBlock Style="{StaticResource MutedText}"
                                                               Text="{Binding MoveCount, StringFormat='{}{0} moves'}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
