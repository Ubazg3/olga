<UserControl x:Class="CheckersClient.Views.GameOverView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CheckersClient.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:GameOverViewModel, IsDesignTimeCreatable=False}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid Background="{StaticResource WindowBackgroundBrush}">
        <Border MaxWidth="520" Style="{StaticResource Panel}"
                VerticalAlignment="Center" HorizontalAlignment="Center"
                Padding="40">
            <StackPanel HorizontalAlignment="Center">
                <!-- Big result emblem.  Colour depends on which DataTrigger fires. -->
                <Border Width="120" Height="120" CornerRadius="60"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,20">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource MutedTextBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsWin}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource SuccessBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsLoss}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource DangerBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsDraw}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource InfoBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="64" Foreground="White">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="·" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsWin}"  Value="True"><Setter Property="Text" Value="♛" /></DataTrigger>
                                    <DataTrigger Binding="{Binding IsLoss}" Value="True"><Setter Property="Text" Value="✕" /></DataTrigger>
                                    <DataTrigger Binding="{Binding IsDraw}" Value="True"><Setter Property="Text" Value="=" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

                <TextBlock Style="{StaticResource H1Text}"
                           Text="{Binding Title}"
                           HorizontalAlignment="Center" />
                <TextBlock Style="{StaticResource MutedText}"
                           Text="{Binding Subtitle}"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0" />

                <Border Height="1" Background="{StaticResource DividerBrush}"
                        Margin="0,24" />

                <!-- Game summary -->
                <Grid HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Style="{StaticResource MutedText}" Text="Result reason" />
                    <TextBlock Grid.Row="0" Grid.Column="1"
                               Style="{StaticResource BodyText}"
                               Text="{Binding FinalState.EndReason, Converter={StaticResource GameResult}}" />

                    <TextBlock Grid.Row="1" Grid.Column="0"
                               Style="{StaticResource MutedText}" Text="Total moves" Margin="0,8,0,0" />
                    <TextBlock Grid.Row="1" Grid.Column="1"
                               Style="{StaticResource BodyText}"
                               Text="{Binding FinalState.MoveCount}"
                               Margin="0,8,0,0" />

                    <TextBlock Grid.Row="2" Grid.Column="0"
                               Style="{StaticResource MutedText}" Text="White pieces left" Margin="0,8,0,0" />
                    <TextBlock Grid.Row="2" Grid.Column="1"
                               Style="{StaticResource BodyText}"
                               Text="{Binding FinalState.WhitePiecesLeft}"
                               Margin="0,8,0,0" />

                    <TextBlock Grid.Row="3" Grid.Column="0"
                               Style="{StaticResource MutedText}" Text="Black pieces left" Margin="0,8,0,0" />
                    <TextBlock Grid.Row="3" Grid.Column="1"
                               Style="{StaticResource BodyText}"
                               Text="{Binding FinalState.BlackPiecesLeft}"
                               Margin="0,8,0,0" />
                </Grid>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,24,0,0">
                    <Button Style="{StaticResource SecondaryButton}"
                            Content="Back to lobby"
                            Command="{Binding BackToLobbyCommand}"
                            Margin="0,0,8,0" />
                    <Button Style="{StaticResource PrimaryButton}"
                            Content="Play again"
                            Command="{Binding PlayAgainCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
