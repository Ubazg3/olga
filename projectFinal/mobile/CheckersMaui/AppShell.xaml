<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:pages="clr-namespace:CheckersMaui.Pages"
       x:Class="CheckersMaui.AppShell"
       Shell.FlyoutBehavior="Disabled">

    <!-- Routes match the same flat-navigation pattern the school
         reference uses. The phone never sees a flyout drawer; pages
         transition with Shell.Current.GoToAsync("//Route"). -->
    <ShellContent Route="Login"        ContentTemplate="{DataTemplate pages:LoginPage}" />
    <ShellContent Route="SignUp"       ContentTemplate="{DataTemplate pages:SignUpPage}" />
    <ShellContent Route="Home"         ContentTemplate="{DataTemplate pages:HomePage}" />
    <ShellContent Route="Profile"      ContentTemplate="{DataTemplate pages:ProfilePage}" />
    <ShellContent Route="GameHistory"  ContentTemplate="{DataTemplate pages:GameHistoryPage}" />
    <ShellContent Route="Leaderboard"  ContentTemplate="{DataTemplate pages:LeaderboardPage}" />
</Shell>
