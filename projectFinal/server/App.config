<?xml version="1.0" encoding="utf-8" ?>
<configuration>

  <appSettings>
    <add key="aspnet:UseTaskFriendlySynchronizationContext" value="true" />
  </appSettings>

  <!-- WCF Service Library configuration. F5 launches WcfSvcHost.exe,
       which reads this file, hosts the service, and then opens
       WcfTestClient.exe pointing at the metadata endpoint below.
       NetTcpBinding is used because it doesn't go through HTTP.SYS
       and therefore requires no URL-ACL reservation — works as a
       normal user out of the box. WCF Test Client supports net.tcp
       services through the mexTcpBinding endpoint defined here. -->
  <system.serviceModel>

    <bindings>
      <netTcpBinding>
        <binding name="CheckersTcp"
                 maxReceivedMessageSize="2097152"
                 maxBufferSize="2097152"
                 maxBufferPoolSize="524288"
                 sendTimeout="00:05:00"
                 receiveTimeout="00:30:00">
          <readerQuotas maxStringContentLength="262144"
                        maxArrayLength="524288"
                        maxDepth="64"
                        maxBytesPerRead="65536"
                        maxNameTableCharCount="32768" />
          <security mode="None" />
        </binding>
      </netTcpBinding>

      <!-- HTTP binding for the MAUI mobile client. We can't use net.tcp
           on Android, and HTTPS would force the user to install a dev
           cert on every test phone, so plain HTTP is the pragmatic
           choice. The Android side flips the cleartextTrafficPermitted
           switch in network_security_config.xml. The "Design_Time_-
           Addresses" path prefix maps to the URL-ACL that Visual
           Studio installs alongside any WCF Service Library template,
           so the server binds without admin rights. -->
      <basicHttpBinding>
        <binding name="CheckersHttp"
                 maxReceivedMessageSize="2097152"
                 maxBufferSize="2097152"
                 maxBufferPoolSize="524288"
                 sendTimeout="00:05:00"
                 receiveTimeout="00:30:00">
          <readerQuotas maxStringContentLength="262144"
                        maxArrayLength="524288"
                        maxDepth="64"
                        maxBytesPerRead="65536"
                        maxNameTableCharCount="32768" />
          <security mode="None" />
        </binding>
      </basicHttpBinding>
    </bindings>

    <services>
      <service name="CheckersServer.CheckersService">
        <host>
          <baseAddresses>
            <add baseAddress="net.tcp://localhost:9100/CheckersService/" />
            <!-- Mobile-facing HTTP endpoint — port 8733 is the default
                 WCF Service Library address pre-reserved by VS. -->
            <add baseAddress="http://localhost:8733/Design_Time_Addresses/CheckersService/" />
          </baseAddresses>
        </host>

        <endpoint address=""
                  binding="netTcpBinding"
                  bindingConfiguration="CheckersTcp"
                  contract="CheckersServer.ICheckersService" />

        <!-- HTTP / SOAP endpoint for the MAUI app. -->
        <endpoint address=""
                  binding="basicHttpBinding"
                  bindingConfiguration="CheckersHttp"
                  contract="CheckersServer.ICheckersService" />

        <!-- mexTcpBinding: WCF Test Client speaks WS-MEX over net.tcp
             through this endpoint and discovers all 18 operations. -->
        <endpoint address="mex"
                  binding="mexTcpBinding"
                  contract="IMetadataExchange" />

        <!-- mexHttpBinding so dotnet-svcutil (and curl-style WSDL
             dumps) can introspect the service over HTTP. -->
        <endpoint address="mex"
                  binding="mexHttpBinding"
                  contract="IMetadataExchange" />
      </service>
    </services>

    <behaviors>
      <serviceBehaviors>
        <behavior>
          <!-- httpGetEnabled lets a browser hit the base address and
               receive the auto-generated WSDL link. Useful for
               debugging the mobile connection. -->
          <serviceMetadata httpGetEnabled="true" />
          <serviceDebug includeExceptionDetailInFaults="true" />
          <serviceThrottling maxConcurrentCalls="200"
                             maxConcurrentSessions="200"
                             maxConcurrentInstances="200" />
        </behavior>
      </serviceBehaviors>
    </behaviors>

  </system.serviceModel>

</configuration>
